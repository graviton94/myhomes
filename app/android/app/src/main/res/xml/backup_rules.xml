<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup (Android 11 and older): the home and settings, not photos
     (they can pass the 25 MB limit; the backup file in Settings carries them). -->
<full-backup-content>
    <include domain="root" path="app_flutter/home/" />
    <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
</full-backup-content>
