<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the home and settings go to the Google account backup and
     to a new phone; photos travel in the backup file from Settings. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_flutter/home/" />
        <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter/home/" />
        <include domain="root" path="app_flutter/photos/" />
        <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
